---
/**
 * Article template. Body content is rendered from the post's Markdown, so a new
 * article means one new .md file and nothing else.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LogoMark from '../../components/LogoMark.astro';
import ArticleChrome from '../../components/islands/ArticleChrome.vue';
import { authorByName } from '../../data/authors.js';
import ShareButton from '../../components/islands/ShareButton.vue';
import { getPosts, readTime, formatDate, tocFrom, howToTitle } from '../../lib/posts.js';
import { toolBySlug } from '../../data/tools.js';
import { SITE_URL, SITE_NAME, OG_IMAGE } from '../../data/site.js';

/**
 * Posts carry real named authors (src/data/authors.js) with /authors/ pages
 * and Person JSON-LD; unregistered names fall back to a plain byline — never
 * exist is exactly the kind of fabricated E-E-A-T signal Google's people-first
 * an invented persona.
 */

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);

/**
 * One table of contents feeds both the sticky sidebar and the in-article list,
 * so the two never disagree. The generated sections are real h2s on the page,
 * so they belong in it alongside the body's own headings.
 */
const toc = [
  ...tocFrom(headings),
  ...(post.data.howTo.length ? [{ id: 'steps', label: howToTitle(post.data) }] : []),
  ...(post.data.faqs.length ? [{ id: 'faq', label: 'Frequently asked questions' }] : []),
];
/**
 * The sidebar is desktop-only, so the article carries its own copy — server
 * rendered, which is what makes the section links crawlable and gives phone
 * readers the same map of the page.
 */
const showToc = post.data.toc && toc.length >= 3;
const path = `/blog/${post.id}`;

const tools = post.data.tools
  .map((slug) => toolBySlug[slug])
  .filter(Boolean)
  .map((t) => ({ name: t.n, href: `/${t.slug}` }));

// "Keep reading": same category first, then most recent, excluding this post.
const related = posts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => {
    const sameA = a.data.category === post.data.category ? 0 : 1;
    const sameB = b.data.category === post.data.category ? 0 : 1;
    return sameA - sameB || b.data.date - a.data.date;
  })
  .slice(0, 3);

const ogImage = post.data.ogImage || OG_IMAGE;

/**
 * BlogPosting (not the broader Article) because that is what these pages are,
 * plus FAQPage and HowTo when the post carries those sections. Every value is
 * read from frontmatter that the template also renders visibly, which is how
 * the markup stays consistent with the page by construction.
 */
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.excerpt,
    articleSection: post.data.category,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated || post.data.date).toISOString(),
    author: {
      '@type': post.data.author.name === SITE_NAME ? 'Organization' : 'Person',
      name: post.data.author.name,
      // Registered humans point at their profile page; the org fallback
      // keeps the site URL. Spread LAST so the profile URL wins.
      url: SITE_URL,
      ...(authorByName(post.data.author.name) && {
        url: `${SITE_URL}/authors/${authorByName(post.data.author.name).slug}`,
        sameAs: authorByName(post.data.author.name).sameAs,
      }),
    },
    publisher: {
      '@type': 'Organization',
      name: SITE_NAME,
      logo: { '@type': 'ImageObject', url: `${SITE_URL}/icon-512.png` },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE_URL}${path}` },
    image: `${SITE_URL}${ogImage}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Blog', item: `${SITE_URL}/blog` },
      { '@type': 'ListItem', position: 2, name: post.data.category, item: `${SITE_URL}/blog` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: `${SITE_URL}${path}` },
    ],
  },
  ...(post.data.howTo.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'HowTo',
          name: howToTitle(post.data),
          description: post.data.excerpt,
          step: post.data.howTo.map((s, i) => ({
            '@type': 'HowToStep',
            position: i + 1,
            name: s.t,
            text: s.d,
            url: `${SITE_URL}${path}#step-${i + 1}`,
          })),
        },
      ]
    : []),
  ...(post.data.faqs.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: post.data.faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={`${post.data.title} | Epub Studio`}
  description={post.data.excerpt}
  path={path}
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <div class="page">
    <header class="article-header">
      <div class="header-row">
        <a class="brand focus-ring" href="/">
          <LogoMark size={24} />
          <span class="wordmark">Epub Studio<span class="dot">.</span></span>
        </a>
        <nav class="nav">
          <a href="/#tools" class="focus-ring">All tools</a>
          <a href="/style-studio" class="focus-ring">Style Studio</a>
          <a href="/blog" class="focus-ring active">Blog</a>
        </nav>
        <span class="note">free · no signup · in your browser</span>
        <a href="/blog" class="back focus-ring-2">← Blog</a>
      </div>
      <div class="progress-track"></div>
    </header>

    <main id="main" class="main">
      <article class="article">
        <div class="breadcrumb">
          <a href="/blog" class="focus-ring-2">Blog</a> / {post.data.category}
        </div>

        <h1>{post.data.title}</h1>

        <div class="byline">
          <span class="avatar" aria-hidden="true">{post.data.author.initial}</span>
          <div class="byline-text">
            <div class="author">
              {
                authorByName(post.data.author.name) ? (
                  <a
                    class="author-link focus-ring-2"
                    href={`/authors/${authorByName(post.data.author.name).slug}`}
                  >
                    {post.data.author.name}
                  </a>
                ) : (
                  post.data.author.name
                )
              }
            </div>
            <div class="dateline">
              {formatDate(post.data.date)} · {readTime(post)} read
            </div>
          </div>
          <ShareButton client:load />
        </div>

        {
          post.data.ogImage && (
            /* Branded hero. alt="" — it restates the h1 directly above it. */
            <img
              class="hero-card"
              src={post.data.ogImage}
              alt=""
              width="1200"
              height="630"
              loading="eager"
              decoding="async"
            />
          )
        }

        {
          showToc && (
            <nav class="toc-card" aria-labelledby="toc-heading">
              <h2 class="toc-heading" id="toc-heading">
                What's on this page
              </h2>
              <ol class="toc-list">
                {toc.map((t) => (
                  <li>
                    <a href={`#${t.id}`} class="focus-ring-2">
                      {t.label}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <div class="prose">
          <Content />
        </div>

        {
          post.data.howTo.length > 0 && (
            /* A recap of the procedure the body just walked through — the
               visible counterpart of the HowTo markup, in the same order. */
            <section class="block" id="steps">
              <h2 class="block-h2">{howToTitle(post.data)}</h2>
              <ol class="howto">
                {post.data.howTo.map((step, i) => (
                  <li id={`step-${i + 1}`}>
                    <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
                    <div class="step-title">{step.t}</div>
                    <div class="step-body">{step.d}</div>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          post.data.faqs.length > 0 && (
            <section class="block" id="faq">
              <h2 class="block-h2">Frequently asked questions</h2>
              <div class="faq">
                {/* First one open, the rest closed — the home page's pattern,
                    so one answer is visible without hiding the whole block. */}
                {post.data.faqs.map((f, i) => (
                  <details class="faq-item" open={i === 0}>
                    <summary class="focus-ring-inset">
                      <span>{f.q}</span>
                      <span class="chev" aria-hidden="true">
                        ＋
                      </span>
                    </summary>
                    <p>{f.a}</p>
                  </details>
                ))}
              </div>
            </section>
          )
        }

        <div class="cta-card">
          <div class="cta-copy">
            <div class="cta-title">Try it on your own book</div>
            <div class="cta-sub">
              Convert between every major format free — no signup, nothing leaves your device.
            </div>
          </div>
          <a href={tools[0]?.href || '/epub-to-pdf'} class="cta-button focus-ring-ink">
            Open the converter →
          </a>
        </div>

        <div class="keep-reading">
          <div class="kr-kicker">Keep reading</div>
          <div class="kr-grid">
            {
              related.map((p) => (
                <a href={`/blog/${p.id}`} class="kr-card focus-ring-2">
                  <span class="kr-meta">
                    {p.data.category} · {readTime(p)}
                  </span>
                  <span class="kr-title">{p.data.title}</span>
                </a>
              ))
            }
          </div>
        </div>
      </article>

      <ArticleChrome client:load toc={toc} tools={tools} />
    </main>

    <footer class="article-footer">
      <span><a href="/">Epub Studio</a> — free online EPUB tools</span>
      <span>
        <a href="/#tools">All tools</a> · <a href="/blog">Blog</a> · <a href="/about">About</a> ·
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy</a>
      </span>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  /* --- Header with reading progress --- */
  .article-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(250, 247, 242, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(23, 19, 14, 0.14);
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 clamp(16px, 4vw, 48px);
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    white-space: nowrap;
  }
  .brand:hover {
    color: #17130e;
  }
  .wordmark {
    font-family: 'Instrument Serif', serif;
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  .dot {
    color: #ff2e63;
  }
  .nav {
    display: flex;
    gap: 22px;
    font-size: 14px;
    font-weight: 500;
  }
  .nav .active {
    color: #c41e4f;
  }
  .note {
    margin-left: auto;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #6e675d;
  }
  .back {
    display: none;
    margin-left: auto;
    font-size: 13px;
    font-weight: 500;
    color: #6e675d;
  }
  .progress-track {
    height: 3px;
    background: rgba(23, 19, 14, 0.08);
  }

  @media (max-width: 759.98px) {
    .nav,
    .note {
      display: none;
    }
    .back {
      display: inline;
    }
  }

  /* --- Layout --- */
  .main {
    flex: 1;
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: clamp(28px, 4vw, 52px) clamp(16px, 4vw, 48px) clamp(48px, 6vw, 80px);
    display: flex;
    gap: clamp(28px, 4vw, 56px);
    align-items: flex-start;
  }
  .article {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }

  .breadcrumb {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #6e675d;
    margin-bottom: 14px;
  }
  .breadcrumb a {
    color: #6e675d;
  }

  h1 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(32px, 4.5vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(23, 19, 14, 0.14);
    margin-bottom: 26px;
  }

  .hero-card {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(23, 19, 14, 0.14);
    border-radius: 14px;
    box-shadow: 0 1px 0 rgba(23, 19, 14, 0.06);
    margin: 0 0 28px;
  }
  .avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #17130e;
    color: #faf7f2;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
  }
  .byline-text {
    flex: 1;
    min-width: 160px;
  }
  .author {
    font-size: 13.5px;
    font-weight: 600;
  }
  .dateline {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    color: #6e675d;
  }

  /* --- In-article table of contents --- */
  /* Complements the sticky sidebar rather than repeating it: this card shows
     exactly where the sidebar does not (under 760px), so no viewport ever
     renders the same list twice. It is plain server HTML, which is what makes
     the section links crawlable — and mobile-first indexing renders it at the
     width where it is the visible one. */
  .toc-card {
    border: 1px solid rgba(23, 19, 14, 0.16);
    border-left: 3px solid #ff2e63;
    border-radius: 12px;
    background: #fffdf9;
    padding: 18px 20px;
    margin: 0 0 30px;
  }
  .toc-heading {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6e675d;
    margin: 0 0 10px;
  }
  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: toc;
    display: grid;
    gap: 7px;
  }
  .toc-list li {
    counter-increment: toc;
    display: flex;
    gap: 10px;
    font-size: 14.5px;
    line-height: 1.4;
  }
  .toc-list li::before {
    content: counter(toc, decimal-leading-zero);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    /* Pink Ink, not Electric Pink: 12px text must clear WCAG AA (4.5:1). */
    color: #c41e4f;
    flex: none;
    padding-top: 2px;
  }
  .toc-list a {
    color: #17130e;
    text-decoration: none;
  }
  .toc-list a:hover {
    color: #c41e4f;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 760px) {
    .toc-card {
      display: none;
    }
  }

  /* --- Steps recap + FAQ (shared shell) --- */
  .block {
    margin-top: clamp(32px, 4.5vw, 48px);
    scroll-margin-top: 88px;
  }
  .block-h2 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(24px, 2.6vw, 32px);
    letter-spacing: -0.01em;
    margin: 0 0 16px;
  }

  .howto {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 14px;
  }
  .howto li {
    background: #fffdf9;
    border: 1px solid rgba(23, 19, 14, 0.14);
    border-radius: 10px;
    padding: 16px;
    scroll-margin-top: 88px;
  }
  .step-num {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #c41e4f;
  }
  .step-title {
    font-weight: 600;
    font-size: 15px;
    margin: 6px 0 4px;
  }
  .step-body {
    font-size: 13.5px;
    line-height: 1.5;
    color: #6e675d;
  }

  .faq {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(23, 19, 14, 0.14);
  }
  .faq-item {
    border-bottom: 1px solid rgba(23, 19, 14, 0.14);
  }
  .faq-item summary {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 15px 2px;
    font-size: 15px;
    font-weight: 600;
    color: #17130e;
    cursor: pointer;
    min-height: 44px;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary:hover {
    color: #c41e4f;
  }
  .chev {
    font-size: 18px;
    color: #ff2e63;
    transition: transform 0.2s;
    transform: rotate(0deg);
    flex: none;
  }
  .faq-item[open] .chev {
    transform: rotate(45deg);
  }
  .faq-item p {
    margin: 0;
    padding: 0 2px 16px;
    font-size: 14.5px;
    line-height: 1.65;
    color: #454037;
    max-width: 65ch;
    text-wrap: pretty;
  }

  /* --- CTA card --- */
  .cta-card {
    margin-top: 32px;
    border: 1px solid rgba(23, 19, 14, 0.16);
    border-radius: 14px;
    background: #fffdf9;
    padding: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }
  .cta-copy {
    flex: 1;
    min-width: 220px;
  }
  .cta-title {
    font-family: 'Instrument Serif', serif;
    font-size: 22px;
    letter-spacing: -0.01em;
    margin-bottom: 4px;
  }
  .cta-sub {
    font-size: 13.5px;
    color: #6e675d;
  }
  .cta-button {
    flex: none;
    background: #c41e4f;
    color: #fff;
    border-radius: 10px;
    padding: 13px 22px;
    font-size: 14.5px;
    font-weight: 600;
    min-height: 48px;
    display: flex;
    align-items: center;
  }
  .cta-button:hover {
    box-shadow: 0 5px 16px rgba(196, 30, 79, 0.35);
    color: #fff;
  }
  .focus-ring-ink:focus-visible {
    outline: 2px solid #17130e;
    outline-offset: 2px;
  }

  /* --- Keep reading --- */
  .keep-reading {
    margin-top: 36px;
  }
  .kr-kicker {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6e675d;
    border-bottom: 1px solid rgba(23, 19, 14, 0.14);
    padding-bottom: 8px;
    margin-bottom: 14px;
  }
  .kr-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: 12px;
  }
  .kr-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: #fffdf9;
    border: 1px solid rgba(23, 19, 14, 0.14);
    border-radius: 10px;
    padding: 16px;
    color: #17130e;
    transition: border-color 0.15s;
  }
  .kr-card:hover {
    border-color: #ff2e63;
    color: #17130e;
  }
  .kr-meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #6e675d;
  }
  .kr-title {
    font-family: 'Instrument Serif', serif;
    font-size: 18.5px;
    line-height: 1.2;
  }

  .article-footer {
    border-top: 1px solid rgba(23, 19, 14, 0.14);
    padding: 20px clamp(16px, 4vw, 48px);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #6e675d;
    max-width: 1240px;
    margin: 0 auto;
    width: 100%;
  }
  .article-footer a {
    color: #6e675d;
  }
</style>

