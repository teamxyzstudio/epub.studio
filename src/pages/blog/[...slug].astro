---
/**
 * Article template. Body content is rendered from the post's Markdown, so a new
 * article means one new .md file and nothing else.
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LogoMark from '../../components/LogoMark.astro';
import ArticleChrome from '../../components/islands/ArticleChrome.vue';
import ShareButton from '../../components/islands/ShareButton.vue';
import { getPosts, readTime, formatDate, tocFrom } from '../../lib/posts.js';
import { toolBySlug } from '../../data/tools.js';
import { SITE_URL, SITE_NAME, OG_IMAGE } from '../../data/site.js';

/**
 * Posts carry an organization byline ("Epub Studio") rather than invented
 * personal authors — asserting a named human author or reviewer who does not
 * exist is exactly the kind of fabricated E-E-A-T signal Google's people-first
 * guidance penalises. Swap to Person entries only when real named authors join.
 */

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);

const toc = tocFrom(headings);
const path = `/blog/${post.id}`;

const tools = post.data.tools
  .map((slug) => toolBySlug[slug])
  .filter(Boolean)
  .map((t) => ({ name: t.n, href: `/${t.slug}` }));

// "Keep reading": same category first, then most recent, excluding this post.
const related = posts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => {
    const sameA = a.data.category === post.data.category ? 0 : 1;
    const sameB = b.data.category === post.data.category ? 0 : 1;
    return sameA - sameB || b.data.date - a.data.date;
  })
  .slice(0, 3);

const ogImage = post.data.ogImage || OG_IMAGE;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.excerpt,
    articleSection: post.data.category,
    datePublished: post.data.date.toISOString(),
    dateModified: (post.data.updated || post.data.date).toISOString(),
    author: {
      '@type': post.data.author.name === SITE_NAME ? 'Organization' : 'Person',
      name: post.data.author.name,
      url: SITE_URL,
    },
    publisher: {
      '@type': 'Organization',
      name: SITE_NAME,
      logo: { '@type': 'ImageObject', url: `${SITE_URL}/icon-512.png` },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `${SITE_URL}${path}` },
    image: `${SITE_URL}${ogImage}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Blog', item: `${SITE_URL}/blog` },
      { '@type': 'ListItem', position: 2, name: post.data.category, item: `${SITE_URL}/blog` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: `${SITE_URL}${path}` },
    ],
  },
];
---

<BaseLayout
  title={`${post.data.title} | Epub Studio`}
  description={post.data.excerpt}
  path={path}
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <div class="page">
    <header class="article-header">
      <div class="header-row">
        <a class="brand focus-ring" href="/">
          <LogoMark size={24} />
          <span class="wordmark">Epub Studio<span class="dot">.</span></span>
        </a>
        <nav class="nav">
          <a href="/#tools" class="focus-ring">All tools</a>
          <a href="/style-studio" class="focus-ring">Style Studio</a>
          <a href="/blog" class="focus-ring active">Blog</a>
        </nav>
        <span class="note">free · no signup · in your browser</span>
        <a href="/blog" class="back focus-ring-2">← Blog</a>
      </div>
      <div class="progress-track"></div>
    </header>

    <main id="main" class="main">
      <article class="article">
        <div class="breadcrumb">
          <a href="/blog" class="focus-ring-2">Blog</a> / {post.data.category}
        </div>

        <h1>{post.data.title}</h1>

        <div class="byline">
          <span class="avatar" aria-hidden="true">{post.data.author.initial}</span>
          <div class="byline-text">
            <div class="author">{post.data.author.name}</div>
            <div class="dateline">
              {formatDate(post.data.date)} · {readTime(post)} read
            </div>
          </div>
          <ShareButton client:load />
        </div>

        {
          post.data.ogImage && (
            /* Branded hero. alt="" — it restates the h1 directly above it. */
            <img
              class="hero-card"
              src={post.data.ogImage}
              alt=""
              width="1200"
              height="630"
              loading="eager"
              decoding="async"
            />
          )
        }

        <div class="prose">
          <Content />
        </div>

        <div class="cta-card">
          <div class="cta-copy">
            <div class="cta-title">Try it on your own book</div>
            <div class="cta-sub">
              Convert between every major format free — no signup, nothing leaves your device.
            </div>
          </div>
          <a href={tools[0]?.href || '/epub-to-pdf'} class="cta-button focus-ring-ink">
            Open the converter →
          </a>
        </div>

        <div class="keep-reading">
          <div class="kr-kicker">Keep reading</div>
          <div class="kr-grid">
            {
              related.map((p) => (
                <a href={`/blog/${p.id}`} class="kr-card focus-ring-2">
                  <span class="kr-meta">
                    {p.data.category} · {readTime(p)}
                  </span>
                  <span class="kr-title">{p.data.title}</span>
                </a>
              ))
            }
          </div>
        </div>
      </article>

      <ArticleChrome client:load toc={toc} tools={tools} />
    </main>

    <footer class="article-footer">
      <span><a href="/">Epub Studio</a> — free online EPUB tools</span>
      <span>
        <a href="/#tools">All tools</a> · <a href="/blog">Blog</a> · <a href="/about">About</a> ·
        <a href="/privacy">Privacy</a>
      </span>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  /* --- Header with reading progress --- */
  .article-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(250, 247, 242, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(23, 19, 14, 0.14);
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 clamp(16px, 4vw, 48px);
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    white-space: nowrap;
  }
  .brand:hover {
    color: #17130e;
  }
  .wordmark {
    font-family: 'Instrument Serif', serif;
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  .dot {
    color: #ff2e63;
  }
  .nav {
    display: flex;
    gap: 22px;
    font-size: 14px;
    font-weight: 500;
  }
  .nav .active {
    color: #c41e4f;
  }
  .note {
    margin-left: auto;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #6e675d;
  }
  .back {
    display: none;
    margin-left: auto;
    font-size: 13px;
    font-weight: 500;
    color: #6e675d;
  }
  .progress-track {
    height: 3px;
    background: rgba(23, 19, 14, 0.08);
  }

  @media (max-width: 759.98px) {
    .nav,
    .note {
      display: none;
    }
    .back {
      display: inline;
    }
  }

  /* --- Layout --- */
  .main {
    flex: 1;
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: clamp(28px, 4vw, 52px) clamp(16px, 4vw, 48px) clamp(48px, 6vw, 80px);
    display: flex;
    gap: clamp(28px, 4vw, 56px);
    align-items: flex-start;
  }
  .article {
    flex: 1;
    min-width: 0;
    max-width: 720px;
  }

  .breadcrumb {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #6e675d;
    margin-bottom: 14px;
  }
  .breadcrumb a {
    color: #6e675d;
  }

  h1 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(32px, 4.5vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(23, 19, 14, 0.14);
    margin-bottom: 26px;
  }

  .hero-card {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(23, 19, 14, 0.14);
    border-radius: 14px;
    box-shadow: 0 1px 0 rgba(23, 19, 14, 0.06);
    margin: 0 0 28px;
  }
  .avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #17130e;
    color: #faf7f2;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
  }
  .byline-text {
    flex: 1;
    min-width: 160px;
  }
  .author {
    font-size: 13.5px;
    font-weight: 600;
  }
  .dateline {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    color: #6e675d;
  }

  /* --- CTA card --- */
  .cta-card {
    margin-top: 32px;
    border: 1px solid rgba(23, 19, 14, 0.16);
    border-radius: 14px;
    background: #fffdf9;
    padding: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }
  .cta-copy {
    flex: 1;
    min-width: 220px;
  }
  .cta-title {
    font-family: 'Instrument Serif', serif;
    font-size: 22px;
    letter-spacing: -0.01em;
    margin-bottom: 4px;
  }
  .cta-sub {
    font-size: 13.5px;
    color: #6e675d;
  }
  .cta-button {
    flex: none;
    background: #c41e4f;
    color: #fff;
    border-radius: 10px;
    padding: 13px 22px;
    font-size: 14.5px;
    font-weight: 600;
    min-height: 48px;
    display: flex;
    align-items: center;
  }
  .cta-button:hover {
    box-shadow: 0 5px 16px rgba(196, 30, 79, 0.35);
    color: #fff;
  }
  .focus-ring-ink:focus-visible {
    outline: 2px solid #17130e;
    outline-offset: 2px;
  }

  /* --- Keep reading --- */
  .keep-reading {
    margin-top: 36px;
  }
  .kr-kicker {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6e675d;
    border-bottom: 1px solid rgba(23, 19, 14, 0.14);
    padding-bottom: 8px;
    margin-bottom: 14px;
  }
  .kr-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: 12px;
  }
  .kr-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: #fffdf9;
    border: 1px solid rgba(23, 19, 14, 0.14);
    border-radius: 10px;
    padding: 16px;
    color: #17130e;
    transition: border-color 0.15s;
  }
  .kr-card:hover {
    border-color: #ff2e63;
    color: #17130e;
  }
  .kr-meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #6e675d;
  }
  .kr-title {
    font-family: 'Instrument Serif', serif;
    font-size: 18.5px;
    line-height: 1.2;
  }

  .article-footer {
    border-top: 1px solid rgba(23, 19, 14, 0.14);
    padding: 20px clamp(16px, 4vw, 48px);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #6e675d;
    max-width: 1240px;
    margin: 0 auto;
    width: 100%;
  }
  .article-footer a {
    color: #6e675d;
  }
</style>

