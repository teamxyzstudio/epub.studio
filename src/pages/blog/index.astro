---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BlogIndex from '../../components/islands/BlogIndex.vue';
import { getPosts, toCard } from '../../lib/posts.js';
import { CATEGORIES } from '../../content.config.js';
import { SITE_URL, SITE_NAME } from '../../data/site.js';

const posts = await getPosts();
const featuredPost = posts.find((p) => p.data.featured) || null;
const rest = posts.filter((p) => p !== featuredPost);

const cards = rest.map(toCard);
const featured = featuredPost ? toCard(featuredPost) : null;

const nav = [
  { label: 'All tools', href: '/#tools' },
  { label: 'Style Studio', href: '/style-studio' },
  { label: 'Blog', href: '/blog', active: true },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `${SITE_NAME} — Blog`,
    url: `${SITE_URL}/blog`,
    description:
      'Practical guides for authors and readers — how ebook formats work, how to fix broken files, and how to make every book a pleasure to read.',
    blogPost: posts.slice(0, 10).map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: `${SITE_URL}/blog/${p.id}`,
      datePublished: p.data.date.toISOString(),
      author: { '@type': 'Person', name: p.data.author.name },
    })),
  },
];
---

<BaseLayout
  title="The Epub Studio blog — ebooks, formats and typesetting"
  description="Practical guides for authors and readers — how ebook formats work, how to fix broken files, and how to make every book a pleasure to read."
  path="/blog"
  jsonLd={jsonLd}
>
  <div class="page">
    <SiteHeader nav={nav} mobileNote="blog" />

    <main id="main" class="main">
      <div class="intro">
        <div class="kicker">The Epub Studio blog</div>
        <h1>Notes on ebooks, formats, and beautiful typesetting</h1>
        <p>
          Practical guides for authors and readers — how formats work, how to fix broken files, and
          how to make every book a pleasure to read.
        </p>
      </div>

      <!-- pageSize covers every post: the whole archive is crawlable from this
           page's server HTML (audit D3); revisit with static pagination past ~40. -->
      <BlogIndex
        client:load
        posts={cards}
        featured={featured}
        categories={CATEGORIES}
        pageSize={cards.length}
      />
    </main>

    <footer class="blog-footer">
      <span><a href="/">Epub Studio</a> — free online EPUB tools</span>
      <span>
        <a href="/#tools">All tools</a> · <a href="/blog">Blog</a> · <a href="/about">About</a> ·
        <a href="/privacy">Privacy</a>
      </span>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .main {
    flex: 1;
    max-width: 1240px;
    margin: 0 auto;
    width: 100%;
    padding: clamp(28px, 4vw, 56px) clamp(16px, 4vw, 48px) clamp(48px, 6vw, 80px);
  }

  .intro {
    max-width: 820px;
  }
  .kicker {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6e675d;
    margin-bottom: 12px;
  }
  .intro h1 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 12px;
    text-wrap: balance;
  }
  .intro p {
    font-size: clamp(15px, 1.3vw, 17.5px);
    line-height: 1.55;
    color: #6e675d;
    margin: 0;
    max-width: 58ch;
    text-wrap: pretty;
  }

  .blog-footer {
    border-top: 1px solid rgba(23, 19, 14, 0.14);
    padding: 20px clamp(16px, 4vw, 48px);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #6e675d;
    max-width: 1240px;
    margin: 0 auto;
    width: 100%;
  }
  .blog-footer a {
    color: #6e675d;
  }
</style>
