---
/**
 * English tool pages — thin wrapper over ToolPageShell. The Spanish twin
 * lives at es/[slug].astro; keep getStaticPaths/jsonLd changes in sync.
 */
import ToolPageShell from '../components/ToolPageShell.astro';
import { getToolPage, toolSlugs } from '../data/tool-pages.js';
import { esToolSlugs } from '../data/tool-pages.es.js';
import { TOOL_CHROME, toolAlternates } from '../lib/i18n.js';
import { SITE_URL } from '../data/site.js';

export function getStaticPaths() {
  return toolSlugs.map((slug) => ({
    params: { slug },
    props: { page: { ...getToolPage(slug), ogImage: `/tool-og/${slug}.png` } },
  }));
}

const { page } = Astro.props;
const { slug } = Astro.params;
const path = `/${slug}`;
const alternates = toolAlternates(slug, esToolSlugs.includes(slug) ? ['en', 'es'] : ['en']);

// Structured data: FAQPage + HowTo + breadcrumb, as required by README §SEO.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  // Only where the page renders a how-to block. A reference page with no
  // visible steps must not claim HowTo markup for steps that are not there.
  ...(page.howTo.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'HowTo',
          name: page.howToTitle,
          step: page.howTo.map((s, i) => ({
            '@type': 'HowToStep',
            position: i + 1,
            name: s.t,
            text: s.d,
          })),
        },
      ]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Tools', item: `${SITE_URL}/#tools` },
      { '@type': 'ListItem', position: 2, name: page.group, item: `${SITE_URL}/#tools` },
      { '@type': 'ListItem', position: 3, name: page.h1, item: `${SITE_URL}${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: page.schema?.name || page.n,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: page.schema ? 'Any modern web browser' : 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    // A page that has written its own description gets it; the generic entry
    // stays bare rather than repeating one blurb across twenty-odd tools.
    // No aggregateRating anywhere: the site collects no reviews, and inventing
    // star ratings is a manual-action risk as well as a lie.
    ...(page.schema && {
      description: page.schema.description,
      featureList: page.schema.featureList,
      isAccessibleForFree: true,
    }),
  },
];
---

<ToolPageShell {page} {path} {jsonLd} chrome={TOOL_CHROME.en} {alternates} />
