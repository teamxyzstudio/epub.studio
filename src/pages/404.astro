---
/**
 * Real 404. Its existence is load-bearing: with a 404.html in the build,
 * Cloudflare Pages returns a genuine HTTP 404 for unknown URLs instead of
 * soft-404ing the app shell with a 200 (the audit's P0 finding).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout title="Page not found — Epub Studio" description="That page doesn't exist. The tools and the blog are one click away." noindex={true}>
  <div class="page">
    <SiteHeader mobileNote="404" />
    <main id="main" class="main">
      <div class="code">HTTP 404</div>
      <h1>This page doesn't exist.</h1>
      <p class="lede">
        The link may be old or mistyped. Everything on this site lives one
        click from here — and if you arrived hunting for a converter, the
        tools below are real and free.
      </p>
      <nav class="links" aria-label="Recovery links">
        <a class="btn primary focus-ring-2" href="/#tools">All tools →</a>
        <a class="btn focus-ring-2" href="/blog">The blog →</a>
        <a class="btn focus-ring-2" href="/">Home →</a>
      </nav>
    </main>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  .main {
    flex: 1;
    max-width: 920px;
    margin: 0 auto;
    width: 100%;
    padding: clamp(48px, 10vw, 120px) clamp(16px, 4vw, 48px);
  }
  .code {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: #c41e4f;
    margin-bottom: 14px;
  }
  h1 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 10px;
  }
  .lede {
    font-size: clamp(15px, 1.3vw, 17.5px);
    line-height: 1.55;
    color: #6e675d;
    margin: 0 0 28px;
    max-width: 60ch;
  }
  .links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    font-size: 13.5px;
    font-weight: 600;
    color: #17130e;
    border: 1.5px solid rgba(23, 19, 14, 0.25);
    border-radius: 999px;
    padding: 9px 18px;
    min-height: 40px;
  }
  .btn:hover {
    border-color: #c41e4f;
    color: #c41e4f;
  }
  .btn.primary {
    background: #c41e4f;
    border-color: #c41e4f;
    color: #fff;
  }
  .btn.primary:hover {
    box-shadow: 0 5px 16px rgba(196, 30, 79, 0.35);
    color: #fff;
  }
</style>
