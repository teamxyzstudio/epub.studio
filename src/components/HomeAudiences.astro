---
/**
 * §2.5 — four use cases, one contextual link each. Each block is written to
 * stand on its own if lifted out of the page.
 */
import HomeSection from './HomeSection.astro';
import RichText from './RichText.astro';
import { AUDIENCES } from '../data/home-content.js';
---

<HomeSection id="who-for" kicker="WHO IT IS FOR" title="Four people this was built for">
  <div class="cards">
    {
      AUDIENCES.map((a) => (
        <div class="card">
          <h3>{a.title}</h3>
          <p>
            <RichText parts={a.body} />
          </p>
        </div>
      ))
    }
  </div>
</HomeSection>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 12px;
  }
  .card {
    background: #fffdf9;
    border: 1px solid rgba(23, 19, 14, 0.14);
    border-radius: 10px;
    padding: 18px;
  }
  .card h3 {
    margin: 0 0 8px;
    font-family: 'Archivo', system-ui, sans-serif;
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: #17130e;
  }
  .card p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: #454037;
    text-wrap: pretty;
  }
</style>
