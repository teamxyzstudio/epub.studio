---
/**
 * Fixed bottom tab bar, mobile only (mocks/Home.dc.html).
 * The page that renders this must also reserve 76px of bottom padding.
 */
interface Props {
  /** Which tab reads as current — gets the accent colour + 600 weight. */
  active?: 'tools' | 'convert' | 'studio';
}
const { active = 'tools' } = Astro.props;
---

<nav class="tabbar" aria-label="Primary">
  <a href="/#tools" class:list={['tab', 'focus-ring-inset', { on: active === 'tools' }]}>
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <rect x="3" y="3" width="6" height="6" rx="1"></rect>
      <rect x="11" y="3" width="6" height="6" rx="1"></rect>
      <rect x="3" y="11" width="6" height="6" rx="1"></rect>
      <rect x="11" y="11" width="6" height="6" rx="1"></rect>
    </svg>
    <span>Tools</span>
  </a>
  <a href="/epub-to-pdf" class:list={['tab', 'focus-ring-inset', { on: active === 'convert' }]}>
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M4 10h12M12 6l4 4-4 4"></path>
    </svg>
    <span>Convert</span>
  </a>
  <a href="/style-studio" class:list={['tab', 'focus-ring-inset', { on: active === 'studio' }]}>
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M4 6h12M4 10h12M4 14h7"></path>
      <circle cx="14" cy="14" r="2.4"></circle>
    </svg>
    <span>Studio</span>
  </a>
</nav>

<style>
  .tabbar {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    background: rgba(250, 247, 242, 0.96);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgba(23, 19, 14, 0.14);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 9px 0 7px;
    min-height: 44px;
    color: #6e675d;
  }
  .tab span {
    font-size: 10.5px;
    font-weight: 500;
  }

  .tab.on {
    color: #c41e4f;
  }
  .tab.on span {
    font-weight: 600;
  }

  @media (max-width: 759.98px) {
    .tabbar {
      display: flex;
    }
  }
</style>
