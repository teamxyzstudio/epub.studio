---
/**
 * The tool page — one implementation shared by every locale route.
 * /[slug].astro (English) and /es/[slug].astro (Spanish) are thin wrappers
 * that pass a content `page`, the locale `chrome`, and hreflang `alternates`.
 * Layout and every value come from mocks/EPUB to PDF.dc.html.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { inline } from '../lib/inline.js';
import SiteHeader from './SiteHeader.astro';
import ToolRunner from './islands/ToolRunner.vue';

interface Props {
  page: Record<string, any>;
  path: string;
  jsonLd: unknown[];
  chrome: Record<string, any>;
  alternates?: { hreflang: string; href: string }[];
  runnerUi?: Record<string, string>;
}

const { page, path, jsonLd, chrome, alternates = [], runnerUi = {} } = Astro.props;
const sections = page.sections || [];

// The language switcher renders only when this page's twin actually exists —
// a switcher that dead-ends on untranslated pages is worse than none.
const twin = chrome.switch
  ? alternates.find((a) => a.hreflang === chrome.switch.lang)
  : undefined;
---


<BaseLayout
  title={page.seoTitle}
  description={page.metaDescription || page.lede}
  path={path}
  ogImage={page.ogImage}
  jsonLd={jsonLd}
  lang={chrome.lang}
  alternates={alternates}
>
  <div class="page">
    <SiteHeader {...chrome.header} mobileNote={`${page.a} → ${page.b}`} />

    <main id="main" class="main">
      <div class="crumb-row">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/#tools" class="focus-ring-2">{chrome.breadcrumbRoot}</a> / {page.group}
        </nav>
        {
          twin && (
            <a
              class="lang-switch focus-ring-2"
              href={twin.href}
              hreflang={twin.hreflang}
              lang={chrome.switch.lang}
            >
              {chrome.switch.label} →
            </a>
          )
        }
      </div>

      <h1>{page.h1}</h1>
      <p class="lede">{page.lede}</p>
      {
        /* One line pointing at the sibling tool for people who landed on the
           wrong one — above the drop zone, where it can still save them a
           conversion. */
        page.sidenote && <p class="sidenote" set:html={inline(page.sidenote)} />
      }

      {
        page.mode === 'guidance' ? (
          /* No browser-side writer exists for this format. Rather than a dead
             button, the card explains the situation and gives the working route. */
          <div class="tool-card guidance">
            <div class="guidance-kicker">{page.guidance.kicker}</div>
            <h2 class="guidance-title">{page.guidance.title}</h2>
            {page.guidance.body.map((para) => (
              <p class="guidance-body">{para}</p>
            ))}
            <div class="guidance-actions">
              {page.guidance.actions.map((a, i) => (
                <a
                  href={a.href}
                  class:list={['guidance-btn', { primary: i === 0 }, 'focus-ring-2']}
                >
                  {a.label} →
                </a>
              ))}
            </div>
            <p class="guidance-fallback">{page.guidance.fallback}</p>
          </div>
        ) : (
          <div class="tool-card">
            <ToolRunner
              client:load
              slug={page.slug}
              accept={page.accept}
              dropHeadline={page.dropHeadline}
              dropSub={page.dropSub}
              cta={page.cta}
              doneTitle={page.doneTitle}
              downloadLabel={page.downloadLabel}
              dropHeadlineMobile={page.dropHeadlineMobile}
              options={page.options}
              ui={runnerUi}
              mode={page.mode}
            />
          </div>
        )
      }

      {
        /* Reference pages carry no steps; without this guard they rendered a
           how-to heading over an empty list. */
        page.howTo.length > 0 && (
          <section class="block">
            <h2 class="howto-h2">{page.howToTitle}</h2>
            <ol class="howto">
              {page.howTo.map((step, i) => (
                <li>
                  <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
                  <div class="step-title">{step.t}</div>
                  <div class="step-body">{step.d}</div>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        page.explainer && (
          <section class="block">
            <h2>{page.explainerTitle}</h2>
            <div class="explainer">
              {page.explainer.map((card) => (
                <div class="explain-card">
                  <div class="explain-kicker">{card.kicker}</div>
                  <p>{card.body}</p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        sections.map((section) => (
          <section class="block section" id={section.id}>
            <h2>{section.title}</h2>
            {section.lead && <p class="section-lead" set:html={inline(section.lead)} />}
            {section.body?.map((para) => <p set:html={inline(para)} />)}

            {section.groups?.map((g) => (
              <div class="subsection">
                <h3 set:html={inline(g.title)} />
                {g.body.map((para) => (
                  <p set:html={inline(para)} />
                ))}
              </div>
            ))}

            {section.table && (
              /* Wrapped so a wide table scrolls inside itself rather than
                 pushing the whole page sideways on a phone. */
              <div class="table-wrap">
                <table class="section-table">
                  <caption>{section.table.caption}</caption>
                  <thead>
                    <tr>
                      {section.table.head.map((h) => (
                        <th scope="col" set:html={inline(h)} />
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {section.table.rows.map((row) => (
                      <tr>
                        {row.map((cell, i) =>
                          i === 0 ? (
                            <th scope="row" set:html={inline(cell)} />
                          ) : (
                            <td set:html={inline(cell)} />
                          ),
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {section.bullets && (
              <dl class="section-bullets">
                {section.bullets.map((b) => (
                  <div class="bullet">
                    <dt set:html={inline(b.t)} />
                    <dd set:html={inline(b.d)} />
                  </div>
                ))}
              </dl>
            )}

            {section.cards && (
              /* Tool hand-offs: a grid of targets, not a paragraph of links.
                 The whole card is the hit area, so a thumb finds it. */
              <div class="section-cards">
                {section.cards.map((c) => (
                  <a href={c.href} class="section-card focus-ring-2">
                    <span class="card-label">{c.label}</span>
                    <span class="card-desc" set:html={inline(c.d, { links: false })} />
                  </a>
                ))}
              </div>
            )}

            {section.links && (
              <ul class="section-links">
                {section.links.map((l) => (
                  <li>
                    <a href={l.href} class="focus-ring-2">
                      {l.label}
                    </a>
                    <span set:html={inline(l.d)} />
                  </li>
                ))}
              </ul>
            )}

            {section.note && <p class="section-note" set:html={inline(section.note)} />}
          </section>
        ))
      }

      <section class="block">
        <h2>{chrome.questionsH2}</h2>
        <div class="faq">
          {
            page.faqs.map((f) => (
              <details class="faq-item">
                <summary class="focus-ring-inset">
                  <span>{f.q}</span>
                  <span class="chev">＋</span>
                </summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section class="block">
        <h2 class="related-h2">{chrome.relatedH2}</h2>
        <div class="related">
          {
            page.related.map((t) => (
              <a href={t.href ?? `/${t.slug}`} class="related-card focus-ring-2">
                <span class="related-fmt">
                  {t.a} <span class="arrow">→</span> {t.b}
                </span>
                <span class="related-name">{t.n}</span>
              </a>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="tool-footer">
      <span><a href="/">Epub Studio</a> — {chrome.footerTagline}</span>
      <span>
        {chrome.footerLinks.map((l, i) => (
          <>
            {i > 0 && ' · '}
            <a href={l.href}>{l.label}</a>
          </>
        ))}
      </span>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding-bottom: 0;
  }
  @media (max-width: 759.98px) {
    .page {
      padding-bottom: 90px;
    }
  }

  .main {
    flex: 1;
    max-width: 920px;
    margin: 0 auto;
    width: 100%;
    padding: clamp(24px, 4vw, 52px) clamp(16px, 4vw, 48px) clamp(40px, 5vw, 72px);
  }

  .crumb-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .breadcrumb {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #6e675d;
  }
  .breadcrumb a {
    color: #6e675d;
  }
  .lang-switch {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    /* Pink Ink: text-level accent, AA-clean at 12px. */
    color: #c41e4f;
  }
  .lang-switch:hover {
    color: #17130e;
  }

  h1 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    margin: 0 0 10px;
  }

  .lede {
    font-size: clamp(15px, 1.3vw, 17.5px);
    line-height: 1.55;
    color: #6e675d;
    margin: 0 0 clamp(20px, 3vw, 32px);
    max-width: 60ch;
    text-wrap: pretty;
  }

  .tool-card {
    background: #fffdf9;
    border: 1px solid rgba(23, 19, 14, 0.16);
    border-radius: 16px;
    padding: clamp(18px, 3vw, 30px);
    box-shadow: 0 1px 0 rgba(23, 19, 14, 0.06);
  }

  /* --- Guidance card (formats with no browser-side writer) --- */
  .guidance-kicker {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: #6e675d;
    margin-bottom: 10px;
  }
  .guidance-title {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 28px);
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 0 0 12px;
  }
  .guidance-body {
    margin: 0 0 12px;
    font-size: 14.5px;
    line-height: 1.6;
    color: #17130e;
    max-width: 62ch;
    text-wrap: pretty;
  }
  .guidance-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 16px;
  }
  .guidance-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1.5px solid rgba(23, 19, 14, 0.25);
    font-size: 13.5px;
    font-weight: 600;
    color: #17130e;
  }
  .guidance-btn:hover {
    border-color: #ff2e63;
    color: #c41e4f;
  }
  .guidance-btn.primary {
    background: #c41e4f;
    border-color: #c41e4f;
    color: #fff;
  }
  .guidance-btn.primary:hover {
    box-shadow: 0 5px 16px rgba(196, 30, 79, 0.35);
    color: #fff;
  }
  .guidance-fallback {
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid rgba(23, 19, 14, 0.12);
    font-size: 13px;
    line-height: 1.55;
    color: #6e675d;
    max-width: 62ch;
  }

  .block {
    margin-top: clamp(36px, 5vw, 60px);
  }
  .block h2 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(24px, 2.6vw, 32px);
    letter-spacing: -0.01em;
    margin: 0 0 14px;
  }
  .block h2.related-h2 {
    font-size: clamp(22px, 2.4vw, 28px);
  }
  /* The how-to heading carries 18px, not the 14px the other h2s use. */
  .block h2.howto-h2 {
    margin-bottom: 18px;
  }

  .sidenote {
    max-width: 68ch;
    margin: -6px 0 20px;
    padding: 10px 14px;
    background: #fffdf9;
    border: 1px solid rgba(23, 19, 14, 0.16);
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.55;
    color: #6e675d;
  }
  .sidenote :global(.rt-link) {
    color: #c41e4f;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* --- Long-form sections (tool-sections.js) --- */
  .section {
    scroll-margin-top: 84px;
    max-width: 76ch;
  }
  .section p {
    font-size: 15px;
    line-height: 1.65;
    color: #454037;
    margin: 0 0 14px;
    text-wrap: pretty;
  }
  /* The one pulled-out paragraph per section: larger, with the accent rule. */
  .section-lead {
    font-size: 16.5px !important;
    line-height: 1.6 !important;
    color: #17130e !important;
    border-left: 2px solid #ff2e63;
    padding-left: 16px;
    margin-bottom: 20px !important;
  }
  .section-note {
    background: #fffdf9;
    border: 1px solid rgba(23, 19, 14, 0.16);
    border-radius: 12px;
    padding: 16px 18px;
    margin-top: 18px !important;
    font-size: 14.5px !important;
  }
  .subsection {
    margin-top: 22px;
  }
  .subsection h3 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(19px, 2vw, 23px);
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }
  .section :global(code) {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.88em;
    background: rgba(23, 19, 14, 0.07);
    padding: 1px 5px;
    border-radius: 4px;
  }
  .section :global(.rt-link) {
    color: #c41e4f;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .section :global(.rt-link:hover) {
    color: #17130e;
  }

  .table-wrap {
    overflow-x: auto;
    margin: 18px 0 0;
    border: 1px solid rgba(23, 19, 14, 0.16);
    border-radius: 12px;
  }
  .section-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    background: #fffdf9;
  }
  .section-table caption {
    caption-side: top;
    text-align: left;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6e675d;
    padding: 12px 14px 10px;
  }
  .section-table th,
  .section-table td {
    padding: 11px 14px;
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
    border-top: 1px solid rgba(23, 19, 14, 0.14);
  }
  .section-table thead th {
    background: #17130e;
    color: #faf7f2;
    font-size: 12.5px;
    font-weight: 600;
    border-top: none;
    white-space: nowrap;
  }
  .section-table tbody th {
    font-weight: 600;
    color: #17130e;
    min-width: 8.5em;
  }
  .section-table tbody tr:nth-child(even) {
    background: rgba(23, 19, 14, 0.025);
  }

  .section-bullets {
    margin: 18px 0 0;
    display: grid;
    gap: 14px;
  }
  .section-bullets .bullet {
    border-left: 2px solid rgba(23, 19, 14, 0.16);
    padding-left: 14px;
  }
  .section-bullets dt {
    font-weight: 600;
    font-size: 14.5px;
    margin-bottom: 3px;
  }
  .section-bullets dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #6e675d;
  }

  .section-cards {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    gap: 12px;
  }
  .section-card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 15px 16px;
    background: #fffdf9;
    border: 1px solid rgba(23, 19, 14, 0.16);
    border-radius: 12px;
    color: #17130e;
    /* 44px minimum touch target, met comfortably by the padding + two lines. */
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .section-card:hover {
    border-color: #ff2e63;
    transform: translateY(-1px);
    color: #17130e;
  }
  .card-label {
    font-weight: 600;
    font-size: 15px;
    color: #c41e4f;
  }
  .card-desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: #6e675d;
  }
  /* A link inside a card must not look like a second destination. */
  .section-card :global(.rt-link) {
    color: inherit;
    text-decoration-color: rgba(23, 19, 14, 0.35);
  }
  @media (prefers-reduced-motion: reduce) {
    .section-card {
      transition: none;
    }
    .section-card:hover {
      transform: none;
    }
  }

  .section-links {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .section-links li {
    font-size: 14px;
    line-height: 1.6;
    color: #6e675d;
  }
  .section-links a {
    display: block;
    font-weight: 600;
    font-size: 15px;
    color: #c41e4f;
  }
  .section-links a:hover {
    color: #17130e;
  }

  /* --- How to --- */
  .howto {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 14px;
  }
  .howto li {
    background: #fffdf9;
    border: 1px solid rgba(23, 19, 14, 0.14);
    border-radius: 10px;
    padding: 16px;
  }
  .step-num {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #c41e4f;
  }
  .step-title {
    font-weight: 600;
    font-size: 15px;
    margin: 6px 0 4px;
  }
  .step-body {
    font-size: 13.5px;
    line-height: 1.5;
    color: #6e675d;
  }

  /* --- Explainer --- */
  .explainer {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .explain-card {
    flex: 1;
    min-width: min(260px, 100%);
    border: 1px solid rgba(23, 19, 14, 0.14);
    border-radius: 10px;
    padding: 18px;
    background: #fffdf9;
  }
  .explain-kicker {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #6e675d;
    margin-bottom: 8px;
  }
  .explain-card p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: #17130e;
    text-wrap: pretty;
  }

  /* --- FAQ ---
     <details> rather than the mock's JS accordion: the answers stay in the DOM
     when collapsed, so they are crawlable and match the FAQPage schema. */
  .faq {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(23, 19, 14, 0.14);
  }
  .faq-item {
    border-bottom: 1px solid rgba(23, 19, 14, 0.14);
  }
  .faq-item summary {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 15px 2px;
    font-family: 'Archivo', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #17130e;
    cursor: pointer;
    min-height: 44px;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary:hover {
    color: #c41e4f;
  }
  .chev {
    font-size: 18px;
    color: #ff2e63;
    transition: transform 0.2s;
    transform: rotate(0deg);
    flex: none;
  }
  .faq-item[open] .chev {
    transform: rotate(45deg);
  }
  .faq-item p {
    margin: 0;
    padding: 0 2px 16px;
    font-size: 14px;
    line-height: 1.6;
    color: #6e675d;
    max-width: 65ch;
    text-wrap: pretty;
  }

  /* --- Related --- */
  .related {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
    gap: 12px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: #fffdf9;
    border: 1px solid rgba(23, 19, 14, 0.14);
    border-radius: 10px;
    padding: 14px;
    color: #17130e;
    transition: border-color 0.15s;
  }
  .related-card:hover {
    border-color: #ff2e63;
    color: #17130e;
  }
  .related-fmt {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #6e675d;
  }
  .related-fmt .arrow {
    color: #ff2e63;
  }
  .related-name {
    font-size: 14.5px;
    font-weight: 600;
  }

  /* --- Footer --- */
  .tool-footer {
    border-top: 1px solid rgba(23, 19, 14, 0.14);
    padding: 20px clamp(16px, 4vw, 48px);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #6e675d;
    max-width: 1240px;
    margin: 0 auto;
    width: 100%;
  }
  .tool-footer a {
    color: #6e675d;
  }
</style>
