---
/**
 * §2.10 — freshness signal plus the three newest posts.
 *
 * "Last updated" is the build timestamp, so it can never go stale against a
 * hardcoded date: every deploy refreshes it.
 *
 * TODO: verify — a "recently added" changelog belongs here too, but no
 * changelog source exists in the repo yet. Add one and render it rather than
 * inventing release notes.
 */
import HomeSection from './HomeSection.astro';
import RichText from './RichText.astro';
import { BLOG_INTRO } from '../data/home-content.js';
import { getPosts, toCard } from '../lib/posts.js';

const BUILT_AT = new Date();
const lastUpdated = BUILT_AT.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const recent = (await getPosts()).slice(0, 3).map(toCard);
---

<HomeSection id="latest" kicker="FRESHNESS" title={BLOG_INTRO.title} wide>
  <p class="intro">
    <RichText parts={BLOG_INTRO.body} />
  </p>

  <div class="cards">
    {
      recent.map((p) => (
        <a href={p.href} class="card focus-ring-2">
          <span class="meta">
            {p.category} · {p.readTime}
          </span>
          <span class="title">{p.title}</span>
          <span class="excerpt">{p.excerpt}</span>
          <span class="date">{p.date}</span>
        </a>
      ))
    }
  </div>

  <p class="updated">
    Last updated <time datetime={BUILT_AT.toISOString().slice(0, 10)}>{lastUpdated}</time> — the
    date this page was last built.
  </p>
</HomeSection>

<style>
  .intro {
    margin: 0 0 18px;
    font-size: 15.5px;
    line-height: 1.65;
    color: #26211a;
    max-width: 68ch;
    text-wrap: pretty;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 12px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #fffdf9;
    border: 1px solid rgba(23, 19, 14, 0.14);
    border-radius: 10px;
    padding: 18px;
    color: #17130e;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .card:hover {
    border-color: #ff2e63;
    transform: translateY(-2px);
    color: #17130e;
  }
  .meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    color: #6e675d;
  }
  .title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }
  .excerpt {
    font-size: 13.5px;
    line-height: 1.55;
    color: #6e675d;
    text-wrap: pretty;
  }
  .date {
    margin-top: auto;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    color: #6e675d;
  }

  .updated {
    margin: 18px 0 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #6e675d;
  }
</style>
